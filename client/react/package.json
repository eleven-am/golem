{
  "name": "@eleven-am/golem-react",
  "version": "0.3.1",
  "description": "React bindings for the golem live GraphQL client",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc --noEmit -p tsconfig.spec.json && vitest run"
  },
  "peerDependencies": {
    "@eleven-am/golem-client": "^0.3.1",
    "@tanstack/react-query": "^5.0.0",
    "gql.tada": "^1.8.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@eleven-am/golem-client": "*"
  },
  "keywords": [
    "golem",
    "react",
    "hooks",
    "graphql",
    "live-query",
    "realtime",
    "subscriptions",
    "tanstack-query"
  ],
  "license": "GPL-3.0",
  "author": "Roy OSSAI",
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eleven-am/golem.git",
    "directory": "client/react"
  }
