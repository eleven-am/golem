{
  "name": "@eleven-am/golem-client",
  "version": "0.3.1",
  "description": "Live GraphQL client for golem backends",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc --noEmit -p tsconfig.spec.json && vitest run"
  },
  "peerDependencies": {
    "@tanstack/query-core": "^5.0.0",
    "graphql": "^16.0.0 || ^17.0.0",
    "graphql-ws": "^6.0.0"
  },
  "keywords": [
    "golem",
    "graphql",
    "live-query",
    "realtime",
    "subscriptions",
    "tanstack-query",
    "graphql-ws",
    "typescript"
  ],
  "license": "GPL-3.0",
  "author": "Roy OSSAI",
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eleven-am/golem.git",
    "directory": "client/core"
  }
}
