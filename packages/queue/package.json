{
  "name": "@eleven-am/golem-queue",
  "version": "0.5.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest && npm run test:sqlite && npm run test:prisma7-types",
    "test:prisma7-types": "prisma generate --schema test/prisma7/schema.prisma && tsc -p test/prisma7/tsconfig.json --noEmit",
    "test:sqlite": "tsc -p test/sqlite/tsconfig.json && node test/sqlite/out/test/sqlite/integration.js"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@prisma/client": "^7.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "prisma": "^7.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.0",
    "@prisma/adapter-better-sqlite3": "^7.0.0"
  },
  "license": "GPL-3.0",
  "author": "Roy OSSAI",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "prisma",
    "README.md"
  ],
  "description": "Durable job queue for Golem apps: lease-based claiming, retries with backoff, per-handler concurrency, timeouts and cooperative cancellation",
  "keywords": [
    "golem",
    "queue",
    "jobs",
    "worker",
    "prisma",
    "nestjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eleven-am/golem.git",
    "directory": "packages/queue"
  }
}
