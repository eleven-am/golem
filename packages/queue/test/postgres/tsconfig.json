{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node",
    "esModuleInterop": true, "skipLibCheck": true, "strict": false,
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "outDir": "./out", "rootDir": "../.."
  },
  "include": ["*.ts", "generated/**/*.ts", "../../src/**/*.ts"],
  "exclude": ["../../src/**/*.test.ts"]
}
