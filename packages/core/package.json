{
  "name": "@eleven-am/golem-core",
  "version": "0.6.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:typecheck && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "test:typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test:generate": "prisma generate --schema test/prisma/schema.prisma && prisma generate --schema test/prisma-postgres/schema.prisma"
  },
  "dependencies": {
    "@eleven-am/golem-policy": "^0.6.0",
    "dataloader": "^2.2.3",
    "graphql-parse-resolve-info": "^4.14.1",
    "kysely": "^0.29.4",
    "pluralize": "^8.0.0"
  },
  "peerDependencies": {
    "graphql": "^16.0.0"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/pluralize": "^0.0.33",
    "graphql": "^16.11.0",
    "jest": "^29.7.0",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0"
  },
  "license": "GPL-3.0",
  "author": "Roy OSSAI",
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "prisma",
    "README.md"
  ],
  "description": "Golem core: datamodel, engine and policy kernel for schema-animated GraphQL backends",
  "keywords": [
    "graphql",
    "prisma",
    "crud",
    "authorization",
    "casl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eleven-am/golem.git",
    "directory": "packages/core"
  }
}
