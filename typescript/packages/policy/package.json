{
  "name": "@eleven-am/golem-policy",
  "version": "0.6.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:typecheck && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "test:typecheck": "tsc --noEmit -p test/tsconfig.json",
    "test:generate": "prisma generate --schema test/prisma/schema.prisma && prisma generate --schema test/prisma-postgres/schema.prisma && prisma generate --schema test/prisma-arrays/schema.prisma",
    "test:postgres": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js test/sql-divergence.postgres.test.ts"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1"
  },
  "devDependencies": {
    "@casl/prisma": "^2.0.2",
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "pg": "^8.13.0",
    "prisma": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0"
  },
  "license": "GPL-3.0",
  "author": "Roy OSSAI",
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "description": "Golem policy engine: the operator table and evaluator behind CASL condition matching, shared by the in-memory and SQL backends",
  "keywords": [
    "golem",
    "casl",
    "authorization",
    "policy",
    "prisma"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eleven-am/golem.git",
    "directory": "typescript/packages/policy"
  }
}
