{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": ["**/*.ts"],
  "exclude": ["prisma/generated/**", "prisma-postgres/generated/**"]
}
