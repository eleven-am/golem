{
  "name": "golem",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @eleven-am/golem-core -w @eleven-am/golem-generator -w @eleven-am/golem -w @eleven-am/golem-authorizer -w @eleven-am/golem-queue && npm run build -w demo",
    "test": "npm run test --workspaces --if-present",
    "benchmark:hardening": "npm run build -w @eleven-am/golem-core -w @eleven-am/golem-authorizer && node benchmarks/hardening.bench.js"
  },
  "overrides": {
    "ws": "^8.21.0",
    "@apollo/server": "^5.5.1",
    "@hono/node-server": "^1.19.13"
  },
  "license": "GPL-3.0"
}
