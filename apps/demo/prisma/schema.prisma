datasource db {
  provider = "sqlite"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

generator golem {
  provider = "golem"
  output   = "../src/generated/golem"
}

model User {
  id      String   @id @default(cuid())
  email   String   @unique
  name    String?
  phone   String?
  apiKey  String?
  posts   Post[]
  profile Profile?
}

enum PostType {
  PERSONAL
  EDITORIAL
}

model Post {
  id        String   @id @default(cuid())
  title     String
  type      PostType @default(PERSONAL)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
}

model Profile {
  id     String @id @default(cuid())
  bio    String
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}
