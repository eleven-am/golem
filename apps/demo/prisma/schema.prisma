datasource db {
  provider = "sqlite"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

generator golem {
  provider = "golem"
  output   = "../src/generated/golem"
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  name     String?
  phone    String?
  apiKey   String?
  posts    Post[]
  profile  Profile?
  branches Branch[]
}

enum PostType {
  PERSONAL
  EDITORIAL
}

model Post {
  id              String           @id @default(cuid())
  title           String
  type            PostType         @default(PERSONAL)
  published       Boolean          @default(false)
  viewCount       BigInt           @default(0)
  rating          Decimal?
  createdAt       DateTime         @default(now())
  author          User             @relation(fields: [authorId], references: [id])
  authorId        String
  postTags        PostTag[]
  readingSessions ReadingSession[]
}

model Profile {
  id     String @id @default(cuid())
  bio    String
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

model Tag {
  id       String    @id @default(cuid())
  label    String    @unique
  postTags PostTag[]
}

model PostTag {
  post    Post     @relation(fields: [postId], references: [id])
  postId  String
  tag     Tag      @relation(fields: [tagId], references: [id])
  tagId   String
  addedAt DateTime @default(now())

  @@id([postId, tagId])
}

model Branch {
  id       String @id @default(cuid())
  name     String
  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  @@unique([authorId, name])
}

model Play {
  id          Int      @id
  userId      String
  ts          DateTime
  msPlayed    Int
  reasonStart String
  reasonEnd   String
  trackUri    String
  trackName   String
  artistName  String

  @@index([userId, trackUri])
}

model ReadingSession {
  id       String  @id @default(cuid())
  progress Int     @default(0)
  note     String?
  post     Post    @relation(fields: [postId], references: [id])
  postId   String
}
