type Query {
  comment(where: CommentWhereUniqueInput!): Comment
  comments(where: CommentWhereInput, orderBy: [CommentOrderByInput!], cursor: CommentWhereUniqueInput, distinct: [CommentScalarField!], skip: Int, take: Int = 50): [Comment!]!
  post(where: PostWhereUniqueInput!): Post
  posts(where: PostWhereInput, orderBy: [PostOrderByInput!], cursor: PostWhereUniqueInput, distinct: [PostScalarField!], skip: Int, take: Int = 50): [Post!]!
  aggregatePosts(where: PostWhereInput): PostAggregate!
  groupByPosts(by: [PostGroupField!]!, where: PostWhereInput, having: PostGroupHavingInput, orderBy: [PostGroupOrderByInput!], skip: Int, take: Int): [PostGroup!]!
  relationGroupByPosts(by: [PostRelationGroupField!]!, where: PostWhereInput, having: PostRelationGroupHavingInput, orderBy: [PostRelationGroupOrderByInput!], skip: Int, take: Int): [PostRelationGroup!]!
  postTag(where: PostTagWhereUniqueInput!): PostTag
  postTags(where: PostTagWhereInput, orderBy: [PostTagOrderByInput!], cursor: PostTagWhereUniqueInput, distinct: [PostTagScalarField!], skip: Int, take: Int = 50): [PostTag!]!
  tag(where: TagWhereUniqueInput!): Tag
  tags(where: TagWhereInput, orderBy: [TagOrderByInput!], cursor: TagWhereUniqueInput, distinct: [TagScalarField!], skip: Int, take: Int = 50): [Tag!]!
  user(where: UserWhereUniqueInput!): User
  users(where: UserWhereInput, orderBy: [UserOrderByInput!], cursor: UserWhereUniqueInput, distinct: [UserScalarField!], skip: Int, take: Int = 25): [User!]!
  versionedNote(where: VersionedNoteWhereUniqueInput!): VersionedNote
  versionedNotes(where: VersionedNoteWhereInput, orderBy: [VersionedNoteOrderByInput!], cursor: VersionedNoteWhereUniqueInput, distinct: [VersionedNoteScalarField!], skip: Int, take: Int = 50): [VersionedNote!]!
  searchPosts(take: Int!, where: PostWhereInput!): [Post!]!
}

type Mutation {
  createComment(data: CommentCreateInput!): Comment!
  updateComment(where: CommentWhereUniqueInput!, data: CommentUpdateInput!): Comment!
  upsertComment(where: CommentWhereUniqueInput!, create: CommentCreateInput!, update: CommentUpdateInput!): Comment!
  deleteComment(where: CommentWhereUniqueInput!): Comment!
  updateManyComments(where: CommentWhereInput!, data: CommentUpdateManyInput!): BatchPayload!
  deleteManyComments(where: CommentWhereInput!): BatchPayload!
  createPost(data: PostCreateInput!): Post!
  updatePost(where: PostWhereUniqueInput!, data: PostUpdateInput!): Post!
  upsertPost(where: PostWhereUniqueInput!, create: PostCreateInput!, update: PostUpdateInput!): Post!
  deletePost(where: PostWhereUniqueInput!): Post!
  updateManyPosts(where: PostWhereInput!, data: PostUpdateManyInput!): BatchPayload!
  deleteManyPosts(where: PostWhereInput!): BatchPayload!
  createPostTag(data: PostTagCreateInput!): PostTag!
  updatePostTag(where: PostTagWhereUniqueInput!, data: PostTagUpdateInput!): PostTag!
  upsertPostTag(where: PostTagWhereUniqueInput!, create: PostTagCreateInput!, update: PostTagUpdateInput!): PostTag!
  deletePostTag(where: PostTagWhereUniqueInput!): PostTag!
  updateManyPostTags(where: PostTagWhereInput!, data: PostTagUpdateManyInput!): BatchPayload!
  deleteManyPostTags(where: PostTagWhereInput!): BatchPayload!
  createTag(data: TagCreateInput!): Tag!
  updateTag(where: TagWhereUniqueInput!, data: TagUpdateInput!): Tag!
  upsertTag(where: TagWhereUniqueInput!, create: TagCreateInput!, update: TagUpdateInput!): Tag!
  deleteTag(where: TagWhereUniqueInput!): Tag!
  updateManyTags(where: TagWhereInput!, data: TagUpdateManyInput!): BatchPayload!
  deleteManyTags(where: TagWhereInput!): BatchPayload!
  createUser(data: UserCreateInput!): User!
  updateUser(where: UserWhereUniqueInput!, data: UserUpdateInput!): User!
  upsertUser(where: UserWhereUniqueInput!, create: UserCreateInput!, update: UserUpdateInput!): User!
  deleteUser(where: UserWhereUniqueInput!): User!
  updateManyUsers(where: UserWhereInput!, data: UserUpdateManyInput!): BatchPayload!
  deleteManyUsers(where: UserWhereInput!): BatchPayload!
  createVersionedNote(data: VersionedNoteCreateInput!): VersionedNote!
  updateVersionedNote(where: VersionedNoteWhereUniqueInput!, expectedVersion: BigInt!, data: VersionedNoteUpdateInput!): VersionedNote!
  upsertVersionedNote(where: VersionedNoteWhereUniqueInput!, expectation: VersionedNoteConcurrencyExpectationInput!, create: VersionedNoteCreateInput!, update: VersionedNoteUpdateInput!): VersionedNote!
  deleteVersionedNote(where: VersionedNoteWhereUniqueInput!, expectedVersion: BigInt!): VersionedNote!
  publishPost(fail: Boolean!, postID: UUID!): BigInt!
}

type BatchPayload {
  count: Int!
}

enum GolemEventType {
  CREATED
  UPDATED
  DELETED
}

type CommentEvent {
  eventID: UUID!
  causationID: UUID!
  transactionOrdinal: Int!
  recordedAt: DateTime!
  type: GolemEventType!
  id: UUID!
  entity: Comment
}

type PostEvent {
  eventID: UUID!
  causationID: UUID!
  transactionOrdinal: Int!
  recordedAt: DateTime!
  type: GolemEventType!
  id: UUID!
  entity: Post
}

type Subscription {
  commentEvents(where: CommentWhereInput): CommentEvent!
  postEvents(where: PostWhereInput): PostEvent!
}
